# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to git (it's already in .gitignore).

PORT=3000

# Supabase — Project Settings -> API in your Supabase dashboard
SUPABASE_URL=https://vtlxwwnwnlkgdxjipwxc.supabase.co/rest/v1/
SUPABASE_SECRET_KEY=your-supabase-secret-key-here

# NewsData.io — https://newsdata.io/dashboard (free tier)
NEWSDATA_API_KEY=your-newsdata-api-key-here

# Free hosted sentiment model (same one your Java backend used)
SENTIMENT_API_BASE_URL=https://goldenrailgun-new-sentiment-ap.hf.space/gradio_api/call/predict
